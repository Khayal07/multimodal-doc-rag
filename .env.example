# OpenAI API key (required)
OPENAI_API_KEY=sk-...

# LlamaCloud / LlamaParse API key (required, free tier: 1000 pages/day)
LLAMA_CLOUD_API_KEY=llx-...

# LLM used for answer generation
LLM_MODEL=gpt-4o-mini

# Embedding model used for chunk vectorization
EMBEDDING_MODEL=text-embedding-3-small

# Vector database backend: "chroma" (local) or "qdrant" (cloud)
VECTOR_DB_TYPE=chroma

# Directory where ChromaDB persists its data (used when VECTOR_DB_TYPE=chroma)
CHROMA_PERSIST_DIR=data/chroma

# ChromaDB / Qdrant collection name
COLLECTION_NAME=multimodal_docs

# Chunking parameters (character-based)
CHUNK_SIZE=1500
CHUNK_OVERLAP=150

# Retrieval / generation parameters
TOP_K=5
LLM_TEMPERATURE=0.0
MAX_RETRIES=3

# Qdrant Cloud connection (used when VECTOR_DB_TYPE=qdrant)
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=...